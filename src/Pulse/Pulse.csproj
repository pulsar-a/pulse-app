<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 2004+ target brings the Windows toast APIs (alerts). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- LibreHardwareMonitorLib ships per-architecture binaries. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Hardware sensors need admin rights, see app.manifest. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated by tools/IconGen (make icon). -->
    <ApplicationIcon>Resources\Pulse.ico</ApplicationIcon>
    <AssemblyName>Pulse</AssemblyName>
    <RootNamespace>Pulse</RootNamespace>
    <Product>Pulse</Product>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\Pulse.ico" />
    <Resource Include="Resources\Pulse-64.png" />
    <Resource Include="Resources\Pulse-256.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
