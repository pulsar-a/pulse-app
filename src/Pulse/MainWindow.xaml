<ui:FluentWindow x:Class="Pulse.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:Pulse.ViewModels"
                 xmlns:views="clr-namespace:Pulse.Views"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:MainViewModel}"
                 Title="Pulse"
                 Icon="pack://application:,,,/Resources/Pulse.ico"
                 Width="1360" Height="920"
                 MinWidth="480" MinHeight="520"
                 SizeChanged="Window_SizeChanged"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Pulse">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Resources/Pulse-64.png" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Header: machine name, live status, page switcher -->
        <!-- In a narrow window the buttons move under the title (see Window_SizeChanged). -->
        <Grid x:Name="Header" Grid.Row="1" Margin="30,2,30,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="{Binding MachineName}" FontSize="24" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding MachineName}" Style="{StaticResource Metric}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Grid Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse x:Name="LiveHalo" Fill="{DynamicResource Pulse.Live}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Pulse.Live}" />
                    </Grid>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Secondary}" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

            <Button Style="{StaticResource RoundIconButton.Plain}" Margin="0,0,10,0" Command="{Binding Dashboard.BeginEditCommand}"
                    ToolTip="Customize the dashboard" AutomationProperties.Name="Customize dashboard"
                    Visibility="{Binding IsDashboardSelected, Converter={StaticResource BoolToVisibility}}">
                <ui:SymbolIcon Symbol="Edit24" FontSize="18" />
            </Button>

            <Button Style="{StaticResource RoundIconButton.Plain}" Margin="0,0,10,0" Command="{Binding ToggleMiniWindowCommand}"
                    ToolTip="Mini window: a small readout that stays on top" AutomationProperties.Name="Mini window">
                <ui:SymbolIcon Symbol="PictureInPicture24" FontSize="18" />
            </Button>

            <Button Style="{StaticResource RoundIconButton.Plain}" Margin="0,0,10,0" Click="SearchButton_Click"
                    ToolTip="Search sensors (Ctrl+K)" AutomationProperties.Name="Search sensors">
                <ui:SymbolIcon Symbol="Search24" FontSize="18" />
            </Button>

            <!-- Alerts bell: unread badge, and a dropdown with recent alerts. -->
            <Grid DataContext="{Binding Alerts}" Margin="0,0,10,0" VerticalAlignment="Center">
                <ToggleButton x:Name="BellButton" Style="{StaticResource RoundIconButton}" ToolTip="Alerts"
                              AutomationProperties.Name="Alerts" Checked="BellButton_Checked">
                    <ui:SymbolIcon Symbol="Alert24" FontSize="18" />
                </ToggleButton>
                <Border Background="{DynamicResource Pulse.Danger}" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0" IsHitTestVisible="False"
                        Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding UnreadCount}" FontSize="10" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <Popup IsOpen="{Binding IsChecked, ElementName=BellButton}" PlacementTarget="{Binding ElementName=BellButton}"
                       Placement="Bottom" HorizontalOffset="-320" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True"
                       Closed="BellPopup_Closed">
                    <Border Width="360" Background="{DynamicResource Pulse.PopupBackground}" BorderBrush="{DynamicResource Pulse.CardBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="16,14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <ui:Button DockPanel.Dock="Right" Content="Clear" Appearance="Transparent" Padding="8,2"
                                           Command="{Binding ClearCommand}"
                                           Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="Alerts" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="No alerts. Pulse is watching your pump, CPU, GPU and drives."
                                       Visibility="{Binding HasItems, Converter={x:Static views:Converters.InverseBoolToVisibility}}" />

                            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:AlertItem}">
                                            <DockPanel Margin="0,0,0,10">
                                                <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,5,10,0" VerticalAlignment="Top"
                                                         Fill="{DynamicResource Pulse.Warning}" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource Caption}"
                                                           VerticalAlignment="Top" Margin="8,2,0,0" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" FontSize="13"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Message}" Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Pulse.Danger}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCleared}" Value="True">
                                                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Pulse.Live}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <ui:Button Content="Alert settings" Appearance="Transparent" Padding="8,4" Margin="-8,4,0,0"
                                       HorizontalAlignment="Left" Click="AlertSettings_Click" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <Border Background="{DynamicResource Pulse.QuietFill}" CornerRadius="20" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource NavPill}" GroupName="Pages"
                                 IsChecked="{Binding IsDashboardSelected}" ToolTip="Dashboard">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon x:Name="DashboardIcon" Symbol="Gauge24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock x:Name="DashboardLabel" Text="Dashboard" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavPill}" GroupName="Pages"
                                 IsChecked="{Binding IsSensorsSelected}" ToolTip="All sensors">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon x:Name="SensorsIcon" Symbol="TableSimple24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock x:Name="SensorsLabel" Text="All sensors" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavPill}" GroupName="Pages"
                                 IsChecked="{Binding IsSettingsSelected}" ToolTip="Settings"
                                 AutomationProperties.Name="Settings">
                        <ui:SymbolIcon Symbol="Settings24" FontSize="16" />
                    </RadioButton>
                </StackPanel>
            </Border>
            </StackPanel>
        </Grid>

        <!-- Banners -->
        <StackPanel x:Name="Banners" Grid.Row="2" Margin="30,0,30,4">
            <Border Background="{DynamicResource Pulse.Warning.Background}" BorderBrush="{DynamicResource Pulse.Warning.Border}" BorderThickness="1"
                    CornerRadius="10" Padding="14,10" Margin="0,0,0,8"
                    Visibility="{Binding ShowElevationBanner, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Content="Dismiss"
                               Command="{Binding DismissElevationBannerCommand}" />
                    <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="20" Foreground="{DynamicResource Pulse.Warning}" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Pulse isn't running as administrator" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap"
                                   Text="CPU, motherboard and drive sensors need admin rights. Restart Pulse as administrator to see them." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Background="{DynamicResource Pulse.Info.Background}" BorderBrush="{DynamicResource Pulse.Info.Border}" BorderThickness="1"
                    CornerRadius="10" Padding="14,10" Margin="0,0,0,8"
                    Visibility="{Binding ShowDriverBanner, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Appearance="Primary" Content="Get PawnIO" Margin="0,0,6,0"
                                   Command="{Binding OpenPawnIoCommand}" />
                        <ui:Button Appearance="Transparent" Content="Dismiss"
                                   Command="{Binding DismissDriverBannerCommand}" />
                    </StackPanel>
                    <ui:SymbolIcon Symbol="Info24" FontSize="20" Foreground="{DynamicResource Pulse.Info}" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="The PawnIO driver isn't installed" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap"
                                   Text="CPU temperatures, clocks and power, and motherboard fans and voltages, are read through PawnIO. Install it, then restart Pulse." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource Pulse.Danger.Text}" Margin="0,0,0,8"
                       Visibility="{Binding ErrorText, Converter={x:Static views:Converters.NotNullToVisibility}}" />
        </StackPanel>

        <!-- Page content -->
        <!-- Both pages stay alive and are shown or hidden, so switching never rebuilds them. -->
        <Grid Grid.Row="3">
            <views:DashboardView x:Name="DashboardPage" DataContext="{Binding Dashboard}"
                                 Visibility="{Binding DataContext.IsDashboardSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
            <!-- Created on first visit (see MainWindow.xaml.cs), so startup only builds the dashboard. -->
            <ContentControl x:Name="SensorsPage" Focusable="False" IsTabStop="False"
                               Visibility="{Binding DataContext.IsSensorsSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
            <ContentControl x:Name="SettingsPage" Focusable="False" IsTabStop="False"
                                Visibility="{Binding DataContext.IsSettingsSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- Sensor details: slides in from the right over the dimmed page. Click the dimmed part or press Esc to close. -->
        <Grid x:Name="DetailsLayer" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed">
            <Border x:Name="DetailsScrim" Background="{DynamicResource Pulse.Scrim}" MouseLeftButtonDown="DetailsScrim_MouseLeftButtonDown" />
            <views:SensorDetailsView x:Name="DetailsPanel" Width="540" HorizontalAlignment="Right" DataContext="{Binding Details}">
                <views:SensorDetailsView.RenderTransform>
                    <TranslateTransform />
                </views:SensorDetailsView.RenderTransform>
            </views:SensorDetailsView>
        </Grid>

        <!-- Ctrl+K: find any sensor by name, hardware or kind, and open its details. -->
        <Grid x:Name="SearchLayer" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed" DataContext="{Binding Search}">
            <Border Background="{DynamicResource Pulse.Scrim}" MouseLeftButtonDown="SearchScrim_MouseLeftButtonDown" />
            <Border x:Name="SearchBoxCard" Width="620" MaxHeight="540" VerticalAlignment="Top" Margin="0,40,0,0"
                    Background="{DynamicResource Pulse.PopupBackground}" BorderBrush="{DynamicResource Pulse.CardBorder}"
                    BorderThickness="1" CornerRadius="14" RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                    <ScaleTransform />
                </Border.RenderTransform>
                <DockPanel>
                    <ui:TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="12" PlaceholderText="{Binding Prompt}"
                                Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="SearchBox_PreviewKeyDown"
                                AutomationProperties.Name="Search sensors">
                        <ui:TextBox.Icon>
                            <ui:SymbolIcon Symbol="Search24" />
                        </ui:TextBox.Icon>
                    </ui:TextBox>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" Margin="16,8,16,10"
                               Text="↑ ↓ to choose · Enter to open · Esc to close" />
                    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Pulse.Divider}" />
                    <Grid>
                        <TextBlock Text="No sensors match." Style="{StaticResource Secondary}" Margin="16,14"
                                   Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}" />
                        <ListBox x:Name="SearchResults" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
                                 Background="Transparent" BorderThickness="0" Margin="6,4" Focusable="False"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="10,7" Margin="0,1">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Pulse.PillHover}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Pulse.PillSelected}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <EventSetter Event="PreviewMouseLeftButtonUp" Handler="SearchResult_Click" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SearchResult}">
                                    <DockPanel Margin="4,2">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" Style="{StaticResource Metric}"
                                                   FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Launch splash: a cardiac-monitor heartbeat that keeps beating until the first readings arrive. -->
        <views:SplashView x:Name="Splash" Grid.Row="1" Grid.RowSpan="3" />
    </Grid>

</ui:FluentWindow>
