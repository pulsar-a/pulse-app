<ui:FluentWindow x:Class="Pulse.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:Pulse.ViewModels"
                 xmlns:views="clr-namespace:Pulse.Views"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance vm:MainViewModel}"
                 Title="Pulse"
                 Width="1360" Height="920"
                 MinWidth="1120" MinHeight="680"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Pulse" />

        <!-- Header: machine name, live status, page switcher -->
        <Grid Grid.Row="1" Margin="30,2,30,10">
            <StackPanel>
                <TextBlock Text="{Binding MachineName}" FontSize="24"
                           Style="{StaticResource Metric}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Grid Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse x:Name="LiveHalo" Fill="#3DDC97" Opacity="0.35" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="6" Height="6" Fill="#3DDC97" />
                    </Grid>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Secondary}" />
                </StackPanel>
            </StackPanel>

            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="#0FFFFFFF" CornerRadius="20" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource NavPill}" GroupName="Pages"
                                 IsChecked="{Binding IsDashboardSelected}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Gauge24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="Dashboard" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavPill}" GroupName="Pages"
                                 IsChecked="{Binding IsSensorsSelected}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="TableSimple24" FontSize="16" Margin="0,0,6,0" />
                            <TextBlock Text="All sensors" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Banners -->
        <StackPanel Grid.Row="2" Margin="30,0,30,4">
            <Border Background="#29FFC048" BorderBrush="#55FFC048" BorderThickness="1"
                    CornerRadius="10" Padding="14,10" Margin="0,0,0,8"
                    Visibility="{Binding ShowElevationBanner, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Content="Dismiss"
                               Command="{Binding DismissElevationBannerCommand}" />
                    <ui:SymbolIcon Symbol="ShieldKeyhole24" FontSize="20" Foreground="#FFC048" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Pulse isn't running as administrator" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap"
                                   Text="CPU, motherboard and drive sensors need admin rights. Restart Pulse as administrator to see them." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Background="#1F4FA8FF" BorderBrush="#554FA8FF" BorderThickness="1"
                    CornerRadius="10" Padding="14,10" Margin="0,0,0,8"
                    Visibility="{Binding ShowDriverBanner, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Appearance="Primary" Content="Get PawnIO" Margin="0,0,6,0"
                                   Command="{Binding OpenPawnIoCommand}" />
                        <ui:Button Appearance="Transparent" Content="Dismiss"
                                   Command="{Binding DismissDriverBannerCommand}" />
                    </StackPanel>
                    <ui:SymbolIcon Symbol="Info24" FontSize="20" Foreground="#4FA8FF" Margin="0,0,12,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="The PawnIO driver isn't installed" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap"
                                   Text="CPU temperatures, clocks and power, and motherboard fans and voltages, are read through PawnIO. Install it, then restart Pulse." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="{Binding ErrorText}" Foreground="#EF4444" Margin="0,0,0,8"
                       Visibility="{Binding ErrorText, Converter={x:Static views:Converters.NotNullToVisibility}}" />
        </StackPanel>

        <!-- Page content -->
        <!-- Both pages stay alive and are shown or hidden, so switching never rebuilds them. -->
        <Grid Grid.Row="3">
            <views:DashboardView x:Name="DashboardPage" DataContext="{Binding Dashboard}"
                                 Visibility="{Binding DataContext.IsDashboardSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
            <views:SensorsView x:Name="SensorsPage" DataContext="{Binding Sensors}"
                               Visibility="{Binding DataContext.IsSensorsSelected, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- Launch splash: a red heartbeat trace that keeps beating until the first readings arrive. -->
        <Grid x:Name="Splash" Grid.Row="1" Grid.RowSpan="3" Background="#F20F1013">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,60">
                <Grid x:Name="SplashLogo" Width="240" Height="100" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform />
                    </Grid.RenderTransform>

                    <!-- Rings that ripple out from the spike -->
                    <Ellipse x:Name="Ring1" Width="70" Height="70" Stroke="#FF3B5C" StrokeThickness="2"
                             Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                             RenderTransformOrigin="0.5,0.5" Margin="-12,0,0,0">
                        <Ellipse.RenderTransform>
                            <ScaleTransform />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="Ring2" Width="70" Height="70" Stroke="#FF3B5C" StrokeThickness="1.5"
                             Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                             RenderTransformOrigin="0.5,0.5" Margin="-12,0,0,0">
                        <Ellipse.RenderTransform>
                            <ScaleTransform />
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <!-- The trace, revealed left to right by an animated clip -->
                    <Canvas x:Name="Trace" Width="240" Height="100">
                        <Canvas.Clip>
                            <RectangleGeometry x:Name="TraceClip" Rect="0,0,0,100" />
                        </Canvas.Clip>
                        <Path Stroke="#FF3B5C" StrokeThickness="10" Opacity="0.22"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M4,55 L66,55 L76,46 L86,55 L98,55 L108,16 L120,88 L131,55 L146,55 L158,42 L170,55 L236,55" />
                        <Path Stroke="#FF3B5C" StrokeThickness="3.2"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M4,55 L66,55 L76,46 L86,55 L98,55 L108,16 L120,88 L131,55 L146,55 L158,42 L170,55 L236,55">
                            <Path.Effect>
                                <DropShadowEffect Color="#FF3B5C" ShadowDepth="0" BlurRadius="18" Opacity="0.9" />
                            </Path.Effect>
                        </Path>
                    </Canvas>
                </Grid>

                <TextBlock x:Name="SplashTitle" Text="Pulse" FontSize="34" HorizontalAlignment="Center"
                           Margin="0,10,0,0" Opacity="0" Style="{StaticResource Metric}" />
                <TextBlock x:Name="SplashStatus" Text="Reading your hardware…" HorizontalAlignment="Center"
                           Margin="0,6,0,0" Opacity="0" Style="{StaticResource Secondary}" />
            </StackPanel>

            <Grid.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard x:Name="HeartbeatStory">
                        <Storyboard RepeatBehavior="Forever" Duration="0:0:1.5">
                            <!-- Draw the trace -->
                            <RectAnimation Storyboard.TargetName="TraceClip" Storyboard.TargetProperty="Rect"
                                           From="0,0,0,100" To="0,0,240,100" Duration="0:0:0.85">
                                <RectAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseInOut" />
                                </RectAnimation.EasingFunction>
                            </RectAnimation>
                            <DoubleAnimation Storyboard.TargetName="Trace" Storyboard.TargetProperty="Opacity"
                                             From="1" To="0" BeginTime="0:0:1.1" Duration="0:0:0.35" />
                            <!-- Ripple when the trace hits the spike -->
                            <DoubleAnimation Storyboard.TargetName="Ring1" Storyboard.TargetProperty="Opacity"
                                             From="0.8" To="0" BeginTime="0:0:0.42" Duration="0:0:0.9" />
                            <DoubleAnimation Storyboard.TargetName="Ring1"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             From="0.3" To="2.4" BeginTime="0:0:0.42" Duration="0:0:0.9" />
                            <DoubleAnimation Storyboard.TargetName="Ring1"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             From="0.3" To="2.4" BeginTime="0:0:0.42" Duration="0:0:0.9" />
                            <DoubleAnimation Storyboard.TargetName="Ring2" Storyboard.TargetProperty="Opacity"
                                             From="0.6" To="0" BeginTime="0:0:0.58" Duration="0:0:0.9" />
                            <DoubleAnimation Storyboard.TargetName="Ring2"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             From="0.3" To="2.0" BeginTime="0:0:0.58" Duration="0:0:0.9" />
                            <DoubleAnimation Storyboard.TargetName="Ring2"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             From="0.3" To="2.0" BeginTime="0:0:0.58" Duration="0:0:0.9" />
                            <!-- A small heartbeat thump of the whole logo -->
                            <DoubleAnimation Storyboard.TargetName="SplashLogo"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             From="1" To="1.06" BeginTime="0:0:0.42" Duration="0:0:0.12" AutoReverse="True" />
                            <DoubleAnimation Storyboard.TargetName="SplashLogo"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             From="1" To="1.06" BeginTime="0:0:0.42" Duration="0:0:0.12" AutoReverse="True" />
                        </Storyboard>
                    </BeginStoryboard>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="SplashTitle" Storyboard.TargetProperty="Opacity"
                                             To="1" BeginTime="0:0:0.25" Duration="0:0:0.4" />
                            <DoubleAnimation Storyboard.TargetName="SplashStatus" Storyboard.TargetProperty="Opacity"
                                             To="1" BeginTime="0:0:0.45" Duration="0:0:0.4" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
        </Grid>
    </Grid>

    <ui:FluentWindow.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="LiveHalo"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                     From="0.6" To="1.6" Duration="0:0:1.4" />
                    <DoubleAnimation Storyboard.TargetName="LiveHalo"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                     From="0.6" To="1.6" Duration="0:0:1.4" />
                    <DoubleAnimation Storyboard.TargetName="LiveHalo" Storyboard.TargetProperty="Opacity"
                                     From="0.6" To="0" Duration="0:0:1.4" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </ui:FluentWindow.Triggers>
</ui:FluentWindow>
