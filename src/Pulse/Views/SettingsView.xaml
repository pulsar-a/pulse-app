<UserControl x:Class="Pulse.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Pulse.ViewModels"
             xmlns:views="clr-namespace:Pulse.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}">

    <UserControl.Resources>
        <!-- A labelled row inside a settings card: label and hint on the left, control on the right. -->
        <Style x:Key="SettingLabel" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,0,24,24">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left" MinWidth="560">

            <!-- General -->
            <Border Style="{StaticResource PulseCard}">
                <StackPanel>
                    <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" MinWidth="150" VerticalAlignment="Center"
                                  ItemsSource="{Binding IntervalChoices}" SelectedItem="{Binding SelectedInterval}"
                                  DisplayMemberPath="Label" AutomationProperties.Name="Update interval" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Update every" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="How often sensors are read. Faster feels livelier; slower uses a little less power. Drives are read every 5 seconds regardless, and everything slows down while Pulse is minimized."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Startup and tray -->
            <Border Style="{StaticResource PulseCard}">
                <StackPanel>
                    <TextBlock Text="Startup and tray" Style="{StaticResource SectionTitle}" />

                    <DockPanel Margin="0,0,0,14">
                        <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center"
                                         IsChecked="{Binding StartWithWindows}" IsEnabled="{Binding CanChangeStartWithWindows}"
                                         AutomationProperties.Name="Start with Windows" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Start with Windows" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{Binding StartWithWindowsHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,14">
                        <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center"
                                         IsChecked="{Binding ShowTrayIcon}" AutomationProperties.Name="Show tray icon" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Show icon in the notification area" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="A live reading next to the clock. Click it to open Pulse; right-click for options."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel IsEnabled="{Binding ShowTrayIcon}">
                        <DockPanel Margin="0,0,0,14">
                            <ComboBox DockPanel.Dock="Right" MinWidth="220" VerticalAlignment="Center"
                                      ItemsSource="{Binding TrayChoices}" SelectedItem="{Binding SelectedTrayChoice}"
                                      DisplayMemberPath="Label" AutomationProperties.Name="Tray icon shows" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Tray icon shows" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Any sensor can be picked: right-click it on the All sensors page."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="When I close the window" Style="{StaticResource SettingLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,14">
                            <RadioButton Content="Keep Pulse running in the tray" GroupName="CloseAction" Margin="0,0,24,0"
                                         IsChecked="{Binding CloseToTray}" />
                            <RadioButton Content="Exit Pulse" GroupName="CloseAction" IsChecked="{Binding CloseExits}" />
                        </StackPanel>

                        <DockPanel>
                            <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center"
                                             IsChecked="{Binding StartMinimized}" AutomationProperties.Name="Start minimized" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Start in the tray" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Open Pulse hidden, even when you launch it yourself."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Alerts -->
            <Border Style="{StaticResource PulseCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <ui:Button DockPanel.Dock="Right" Content="Send a test notification" VerticalAlignment="Top"
                                   Command="{Binding Alerts.SendTestCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Alert20" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <TextBlock Text="Alerts" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"
                               Text="Pulse notifies you when a reading stays past its limit for the time given, even while it's in the tray. Add your own from the All sensors page: right-click a sensor and choose Alert when above." />

                    <ItemsControl ItemsSource="{Binding AlertRules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AlertRuleViewModel}">
                                <Border BorderBrush="{DynamicResource Pulse.Divider}" BorderThickness="0,1,0,0" Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <ui:ToggleSwitch Grid.RowSpan="2" VerticalAlignment="Top" Margin="0,2,14,0"
                                                         IsChecked="{Binding Enabled}" AutomationProperties.Name="{Binding Name}" />

                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource SettingLabel}" />
                                                <Border Background="{DynamicResource Pulse.Danger}" CornerRadius="4" Padding="5,0" Margin="8,1,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsCritical, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="Critical" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding SensorText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <ui:Button Grid.Column="2" Appearance="Transparent" Padding="8,4" ToolTip="Delete this alert"
                                                   VerticalAlignment="Top" Command="{Binding DeleteCommand}"
                                                   Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}"
                                                   AutomationProperties.Name="Delete alert">
                                            <ui:SymbolIcon Symbol="Delete20" />
                                        </ui:Button>

                                        <!-- "Above [95] °C for [10] seconds" -->
                                        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0"
                                                    IsEnabled="{Binding Enabled}">
                                            <TextBlock Text="{Binding ConditionText}" Style="{StaticResource Secondary}" FontSize="13"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ui:NumberBox Width="120" Value="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}"
                                                          SpinButtonPlacementMode="Compact" MaxDecimalPlaces="1" SmallChange="1"
                                                          AutomationProperties.Name="Threshold" />
                                            <TextBlock Text="{Binding UnitText}" Style="{StaticResource Secondary}" FontSize="13"
                                                       VerticalAlignment="Center" Margin="8,0,16,0" />
                                            <TextBlock Text="for" Style="{StaticResource Secondary}" FontSize="13"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ui:NumberBox Width="100" Value="{Binding HoldSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                          SpinButtonPlacementMode="Compact" MaxDecimalPlaces="0" SmallChange="1" Minimum="0"
                                                          AutomationProperties.Name="Seconds" />
                                            <TextBlock Text="seconds" Style="{StaticResource Secondary}" FontSize="13"
                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DockPanel Margin="0,8,0,0">
                        <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center"
                                         IsChecked="{Binding PlaySoundForCritical}" AutomationProperties.Name="Alarm sound" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Alarm sound for critical alerts" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="Critical alerts stay on screen until you dismiss them." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Units -->
            <Border Style="{StaticResource PulseCard}">
                <StackPanel>
                    <TextBlock Text="Units" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Temperature" Style="{StaticResource SettingLabel}" />
                    <TextBlock Text="Used everywhere in Pulse, including gauges and the sensor list."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <RadioButton Content="Celsius (°C)" GroupName="TemperatureUnit" Margin="0,0,24,0"
                                     IsChecked="{Binding IsCelsius}" />
                        <RadioButton Content="Fahrenheit (°F)" GroupName="TemperatureUnit"
                                     IsChecked="{Binding IsFahrenheit}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Sensors -->
            <Border Style="{StaticResource PulseCard}">
                <StackPanel>
                    <TextBlock Text="Sensors" Style="{StaticResource SectionTitle}" />

                    <DockPanel Margin="0,0,0,18">
                        <ui:Button DockPanel.Dock="Right" Content="Detect again" VerticalAlignment="Center"
                                   Command="{Binding ResetPumpCommand}"
                                   Visibility="{Binding HasPumpChoice, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="CPU pump header" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{Binding PumpText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="Renamed sensors" Style="{StaticResource SettingLabel}" Margin="0,0,0,6" />
                    <TextBlock Text="Rename any sensor on the All sensors page: double-click its name, or right-click it and choose Rename."
                               Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Visibility="{Binding HasRenamedSensors, Converter={x:Static views:Converters.InverseBoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding RenamedSensors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RenamedSensorItem}">
                                <Border BorderBrush="{DynamicResource Pulse.Divider}" BorderThickness="0,1,0,0" Padding="0,8">
                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Right" Content="Reset" Appearance="Transparent"
                                                   Command="{Binding ResetCommand}" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" Style="{StaticResource Secondary}"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource PulseCard}">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource SettingLabel}">
                        <Run Text="Pulse" /> <Run Text="{Binding Version, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding AdminText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding DriverText}" Style="{StaticResource Caption}" />

                    <DockPanel Margin="0,16,0,0">
                        <ui:Button DockPanel.Dock="Right" Content="Open log folder" VerticalAlignment="Center"
                                   Command="{Binding OpenLogFolderCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="FolderOpen20" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Diagnostic log" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{Binding LogPath}" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Settings file" Style="{StaticResource SettingLabel}" />
                        <TextBlock Text="{Binding SettingsPath}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
