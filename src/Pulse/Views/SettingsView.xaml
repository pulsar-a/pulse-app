<UserControl x:Class="Pulse.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Pulse.ViewModels"
             xmlns:views="clr-namespace:Pulse.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}">

    <UserControl.Resources>
        <!-- A labelled row inside a settings card: label and hint on the left, control on the right. -->
        <Style x:Key="SettingLabel" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,0,24,24">
        <!-- Fills the width up to 820 px, left-aligned; narrower windows just get a narrower column. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="820" />
                <ColumnDefinition Width="0" />
            </Grid.ColumnDefinitions>
        <StackPanel>

            <!-- General -->
            <Border Style="{StaticResource PulseCard}">
                <StackPanel>
                    <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" MinWidth="150" VerticalAlignment="Center"
                                  ItemsSource="{Binding IntervalChoices}" SelectedItem="{Binding SelectedInterval}"
                                  DisplayMemberPath="Label" AutomationProperties.Name="Update interval" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Update every" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="How often sensors are read. Faster feels livelier; slower uses a little less power. Drives are read every 5 seconds regardless, and everything slows down while Pulse is minimized."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Startup and tray -->
            <Border Style="{StaticResource PulseCard}">
                <StackPanel>
                    <TextBlock Text="Startup and tray" Style="{StaticResource SectionTitle}" />

                    <DockPanel Margin="0,0,0,14">
                        <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center"
                                         IsChecked="{Binding StartWithWindows}" IsEnabled="{Binding CanChangeStartWithWindows}"
                                         AutomationProperties.Name="Start with Windows" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Start with Windows" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{Binding StartWithWindowsHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,14">
                        <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center"
                                         IsChecked="{Binding ShowTrayIcon}" AutomationProperties.Name="Show tray icon" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Show icon in the notification area" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="A live reading next to the clock. Click it to open Pulse; right-click for options."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel IsEnabled="{Binding ShowTrayIcon}">
                        <DockPanel Margin="0,0,0,14">
                            <ComboBox DockPanel.Dock="Right" MinWidth="220" VerticalAlignment="Center"
                                      ItemsSource="{Binding TrayChoices}" SelectedItem="{Binding SelectedTrayChoice}"
                                      DisplayMemberPath="Label" AutomationProperties.Name="Tray icon shows" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Tray icon shows" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Any sensor can be picked: right-click it on the All sensors page."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="When I close the window" Style="{StaticResource SettingLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,14">
                            <RadioButton Content="Keep Pulse running in the tray" GroupName="CloseAction" Margin="0,0,24,0"
                                         IsChecked="{Binding CloseToTray}" />
                            <RadioButton Content="Exit Pulse" GroupName="CloseAction" IsChecked="{Binding CloseExits}" />
                        </StackPanel>

                        <DockPanel>
                            <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center"
                                             IsChecked="{Binding StartMinimized}" AutomationProperties.Name="Start minimized" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Start in the tray" Style="{StaticResource SettingLabel}" />
                                <TextBlock Text="Open Pulse hidden, even when you launch it yourself."
                                           Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Alerts -->
            <Border Style="{StaticResource PulseCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <ui:Button DockPanel.Dock="Right" Content="Send a test notification" VerticalAlignment="Top"
                                   Command="{Binding Alerts.SendTestCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Alert20" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <TextBlock Text="Alerts" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,0,0,14"
                               Text="Pulse notifies you when a reading stays past its limit for the time given, even while it's in the tray. Add your own from the All sensors page: right-click a sensor and choose Alert when above." />

                    <ItemsControl ItemsSource="{Binding AlertRules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AlertRuleViewModel}">
                                <Border BorderBrush="{DynamicResource Pulse.Divider}" BorderThickness="0,1,0,0" Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <ui:ToggleSwitch Grid.RowSpan="2" VerticalAlignment="Top" Margin="0,2,14,0"
                                                         IsChecked="{Binding Enabled}" AutomationProperties.Name="{Binding Name}" />

                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource SettingLabel}" />
                                                <Border Background="{DynamicResource Pulse.Danger}" CornerRadius="4" Padding="5,0" Margin="8,1,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsCritical, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="Critical" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding SensorText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <ui:Button Grid.Column="2" Appearance="Transparent" Padding="8,4" ToolTip="Delete this alert"
                                                   VerticalAlignment="Top" Command="{Binding DeleteCommand}"
                                                   Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}"
                                                   AutomationProperties.Name="Delete alert">
                                            <ui:SymbolIcon Symbol="Delete20" />
                                        </ui:Button>

                                        <!-- "Above [95] °C for [10] seconds"; the two halves wrap onto two lines in a narrow window. -->
                                        <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                                    IsEnabled="{Binding Enabled}">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding ConditionText}" Style="{StaticResource Secondary}" FontSize="13"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ui:NumberBox Width="120" Value="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}"
                                                          SpinButtonPlacementMode="Compact" MaxDecimalPlaces="1" SmallChange="1"
                                                          AutomationProperties.Name="Threshold" />
                                            <TextBlock Text="{Binding UnitText}" Style="{StaticResource Secondary}" FontSize="13"
                                                       VerticalAlignment="Center" Margin="8,0,16,0" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="for" Style="{StaticResource Secondary}" FontSize="13"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ui:NumberBox Width="100" Value="{Binding HoldSeconds, UpdateSourceTrigger=PropertyChanged}"
                                                          SpinButtonPlacementMode="Compact" MaxDecimalPlaces="0" SmallChange="1" Minimum="0"
                                                          AutomationProperties.Name="Seconds" />
                                            <TextBlock Text="seconds" Style="{StaticResource Secondary}" FontSize="13"
                                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DockPanel Margin="0,8,0,0">
                        <ui:ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center"
                                         IsChecked="{Binding PlaySoundForCritical}" AutomationProperties.Name="Alarm sound" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Alarm sound for critical alerts" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="Critical alerts stay on screen until you dismiss them." Style="{StaticResource Caption}" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- History -->
            <Border Style="{StaticResource PulseCard}">
                <StackPanel>
                    <TextBlock Text="History" Style="{StaticResource SectionTitle}" />

                    <DockPanel Margin="0,0,0,16">
                        <ComboBox DockPanel.Dock="Right" MinWidth="150" VerticalAlignment="Center"
                                  ItemsSource="{Binding RetentionChoices}" SelectedItem="{Binding SelectedRetention}"
                                  DisplayMemberPath="Label" AutomationProperties.Name="Keep history" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Keep history" Style="{StaticResource SettingLabel}" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                                <Run Text="Every sensor's lowest, average and highest value, each minute: about 8 MB a day." />
                                <Run Text="{Binding HistorySizeText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox MinWidth="150" Margin="0,0,8,0" ItemsSource="{Binding ExportRanges}"
                                      SelectedItem="{Binding SelectedExportRange}" DisplayMemberPath="Label"
                                      AutomationProperties.Name="Export range" />
                            <ui:Button Content="Export CSV…" Command="{Binding ExportHistoryCommand}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowDownload20" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Export" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="A spreadsheet with one row per minute and one column per sensor."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Command="{Binding DeleteHistoryCommand}"
                                   AutomationProperties.Name="Delete history">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Content" Value="Delete history" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConfirmingDelete}" Value="True">
                                            <Setter Property="Content" Value="Click again to delete" />
                                            <Setter Property="Foreground" Value="{DynamicResource Pulse.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <TextBlock Text="{Binding HistoryStatus}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Dashboard -->
            <Border Style="{StaticResource PulseCard}">
                <StackPanel>
                    <TextBlock Text="Dashboard" Style="{StaticResource SectionTitle}" />
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="Reset layout" VerticalAlignment="Center"
                                   Command="{Binding ResetDashboardCommand}" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Layout" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="Reorder, resize and hide cards with the pencil button on the dashboard. Reset puts the built-in cards back as they were; pinned sensors stay."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Text="{Binding DashboardStatus}" Style="{StaticResource Caption}" Margin="0,8,0,0"
                               Visibility="{Binding DashboardStatus, Converter={x:Static views:Converters.NotNullToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- Mini window -->
            <Border Style="{StaticResource PulseCard}" Visibility="{Binding HasMini, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Mini window" Style="{StaticResource SectionTitle}" />

                    <DockPanel Margin="0,0,0,14">
                        <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding MiniOpen}" VerticalAlignment="Center"
                                         AutomationProperties.Name="Show the mini window" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Show the mini window" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="A small readout that stays on top of other windows and games. Drag it anywhere; right-click it for options."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="Shows" Style="{StaticResource SettingLabel}" />
                    <ItemsControl ItemsSource="{Binding MiniRows}" Margin="0,6,0,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MiniItemRow}">
                                <Border Background="{DynamicResource Pulse.QuietFill}" CornerRadius="8" Padding="12,6,6,6" Margin="0,0,0,4">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <ui:Button Appearance="Transparent" Padding="6" Command="{Binding MoveUp}" ToolTip="Move up"
                                                       AutomationProperties.Name="Move up">
                                                <ui:SymbolIcon Symbol="ArrowUp16" />
                                            </ui:Button>
                                            <ui:Button Appearance="Transparent" Padding="6" Command="{Binding MoveDown}" ToolTip="Move down"
                                                       AutomationProperties.Name="Move down">
                                                <ui:SymbolIcon Symbol="ArrowDown16" />
                                            </ui:Button>
                                            <ui:Button Appearance="Transparent" Padding="6" Command="{Binding Remove}" ToolTip="Remove"
                                                       AutomationProperties.Name="Remove">
                                                <ui:SymbolIcon Symbol="Dismiss16" />
                                            </ui:Button>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontSize="13" Style="{StaticResource Secondary}"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:Button Content="Add a sensor…" Margin="0,0,8,0" Command="{Binding AddMiniSensorCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="Add16" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Content="Back to the defaults" Appearance="Transparent" Command="{Binding ResetMiniItemsCommand}" />
                    </StackPanel>

                    <TextBlock Text="Layout" Style="{StaticResource SettingLabel}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,16">
                        <RadioButton Content="Stacked" GroupName="MiniLayout" Margin="0,0,24,0" IsChecked="{Binding MiniStacked}" />
                        <RadioButton Content="Side by side" GroupName="MiniLayout" IsChecked="{Binding MiniSideBySide}" />
                    </StackPanel>

                    <DockPanel Margin="0,0,0,16">
                        <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                                   Style="{StaticResource SettingLabel}" Text="{Binding MiniOpacityPercent, StringFormat={}{0:0}%}" />
                        <TextBlock Text="Opacity" Style="{StaticResource SettingLabel}" VerticalAlignment="Center" Width="120" />
                        <Slider Minimum="40" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding MiniOpacityPercent}" AutomationProperties.Name="Mini window opacity" />
                    </DockPanel>

                    <CheckBox Content="Let clicks go through it to the window underneath" IsChecked="{Binding MiniClickThrough}" />
                    <TextBlock Text="Its right-click menu can't be reached then; turn this off here or from the tray icon."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="28,0,0,10" />
                    <CheckBox Content="Hide it while Pulse's own window is in front" IsChecked="{Binding MiniHideWhenPulseActive}"
                              Margin="0,0,0,16" />

                    <TextBlock Text="Shortcut" Style="{StaticResource SettingLabel}" />
                    <TextBlock Text="Shows or hides the mini window from anywhere, even in a game."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    <!-- The current shortcut; "Set" listens for the next keys pressed, "Reset" goes back to Ctrl + Alt + P. -->
                    <WrapPanel Margin="0,8,0,0">
                        <Border x:Name="ShortcutBox" MinWidth="180" CornerRadius="6" Padding="12,7" Margin="0,0,8,4"
                                Background="{DynamicResource Pulse.QuietFill}" BorderThickness="1" Focusable="True"
                                BorderBrush="{DynamicResource Pulse.CardBorder}" AutomationProperties.Name="Current shortcut">
                            <TextBlock Text="{Binding ShortcutText}" FontSize="14" Style="{StaticResource Metric}" FontWeight="Normal" />
                        </Border>
                        <ui:Button x:Name="SetShortcutButton" Margin="0,0,8,4" Command="{Binding SetShortcutCommand}">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                    <Setter Property="Content" Value="Set" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRecordingShortcut}" Value="True">
                                            <Setter Property="Content" Value="Cancel" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>
                        <ui:Button Content="Reset" Appearance="Transparent" Margin="0,0,0,4" Command="{Binding ResetShortcutCommand}"
                                   IsEnabled="{Binding CanResetShortcut}" ToolTip="Back to Ctrl + Alt + P" />
                    </WrapPanel>
                    <TextBlock Text="{Binding ShortcutHint}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding ShortcutHint, Converter={x:Static views:Converters.NotNullToVisibility}}" />
                    <TextBlock Text="{Binding HotkeyProblem}" Foreground="{DynamicResource Pulse.Warning}" FontSize="12" Margin="0,8,0,0"
                               TextWrapping="Wrap" Visibility="{Binding HotkeyProblem, Converter={x:Static views:Converters.NotNullToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- Units -->
            <Border Style="{StaticResource PulseCard}">
                <StackPanel>
                    <TextBlock Text="Units" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Temperature" Style="{StaticResource SettingLabel}" />
                    <TextBlock Text="Used everywhere in Pulse, including gauges and the sensor list."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <RadioButton Content="Celsius (°C)" GroupName="TemperatureUnit" Margin="0,0,24,0"
                                     IsChecked="{Binding IsCelsius}" />
                        <RadioButton Content="Fahrenheit (°F)" GroupName="TemperatureUnit"
                                     IsChecked="{Binding IsFahrenheit}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Sensors -->
            <Border Style="{StaticResource PulseCard}">
                <StackPanel>
                    <TextBlock Text="Sensors" Style="{StaticResource SectionTitle}" />

                    <DockPanel Margin="0,0,0,18">
                        <ui:Button DockPanel.Dock="Right" Content="Detect again" VerticalAlignment="Center"
                                   Command="{Binding ResetPumpCommand}"
                                   Visibility="{Binding HasPumpChoice, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="CPU pump header" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{Binding PumpText}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="Renamed sensors" Style="{StaticResource SettingLabel}" Margin="0,0,0,6" />
                    <TextBlock Text="Rename any sensor: right-click it on the All sensors page and choose Rename, or use the pencil in its details panel."
                               Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Visibility="{Binding HasRenamedSensors, Converter={x:Static views:Converters.InverseBoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding RenamedSensors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RenamedSensorItem}">
                                <Border BorderBrush="{DynamicResource Pulse.Divider}" BorderThickness="0,1,0,0" Padding="0,8">
                                    <DockPanel>
                                        <ui:Button DockPanel.Dock="Right" Content="Reset" Appearance="Transparent"
                                                   Command="{Binding ResetCommand}" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" Style="{StaticResource Secondary}"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{Binding Details}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource PulseCard}">
                <StackPanel>
                    <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource SettingLabel}">
                        <Run Text="Pulse" /> <Run Text="{Binding Version, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding AdminText}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding DriverText}" Style="{StaticResource Caption}" />

                    <DockPanel Margin="0,16,0,0">
                        <ui:Button DockPanel.Dock="Right" Content="Open log folder" VerticalAlignment="Center"
                                   Command="{Binding OpenLogFolderCommand}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="FolderOpen20" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Diagnostic log" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{Binding LogPath}" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="Settings file" Style="{StaticResource SettingLabel}" />
                        <TextBlock Text="{Binding SettingsPath}" Style="{StaticResource Caption}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
