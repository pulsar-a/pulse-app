<UserControl x:Class="Pulse.Views.SensorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Pulse.ViewModels"
             xmlns:controls="clr-namespace:Pulse.Controls"
             xmlns:views="clr-namespace:Pulse.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SensorsViewModel}">

    <UserControl.Resources>
        <!-- Value, Min and Max columns share these widths across header and sensor rows. -->
        <GridLength x:Key="ValueColumn">130</GridLength>

        <!-- Clickable hardware header. -->
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#17FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate DataType="{x:Type vm:HardwareGroupViewModel}">
            <Button Style="{StaticResource HeaderButton}" Margin="0,4,0,4" Command="{Binding ToggleCommand}"
                    AutomationProperties.Name="{Binding Name}">
                <DockPanel>
                    <ui:SymbolIcon DockPanel.Dock="Right" Symbol="ChevronDown24" FontSize="16" VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="-90" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="0" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,14,0"
                               Style="{StaticResource Caption}">
                        <Run Text="{Binding SensorCount, Mode=OneWay}" /> <Run Text="sensors" />
                    </TextBlock>
                    <Border Width="34" Height="34" CornerRadius="9" Background="#14FFFFFF" Margin="0,0,12,0">
                        <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="18" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Secondary}" />
                    </StackPanel>
                </DockPanel>
            </Button>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SensorTypeGroupViewModel}">
            <Grid Margin="62,10,14,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource ValueColumn}" />
                    <ColumnDefinition Width="{StaticResource ValueColumn}" />
                    <ColumnDefinition Width="{StaticResource ValueColumn}" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Style="{StaticResource Secondary}" />
                <TextBlock Grid.Column="1" Text="Value" HorizontalAlignment="Right" Style="{StaticResource Caption}" />
                <TextBlock Grid.Column="2" Text="Min" HorizontalAlignment="Right" Style="{StaticResource Caption}" />
                <TextBlock Grid.Column="3" Text="Max" HorizontalAlignment="Right" Style="{StaticResource Caption}" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SensorRowViewModel}">
            <Border x:Name="Row" Margin="62,0,14,0" Padding="0,5" BorderBrush="#0FFFFFFF" BorderThickness="0,1,0,0"
                    Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{StaticResource ValueColumn}" />
                        <ColumnDefinition Width="{StaticResource ValueColumn}" />
                        <ColumnDefinition Width="{StaticResource ValueColumn}" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" FontSize="13" Style="{StaticResource Secondary}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontSize="13"
                               HorizontalAlignment="Right" Foreground="{Binding ValueBrush}"
                               Style="{StaticResource Metric}" />
                    <TextBlock Grid.Column="2" Text="{Binding MinText}" FontSize="13"
                               HorizontalAlignment="Right" Style="{StaticResource Secondary}" />
                    <TextBlock Grid.Column="3" Text="{Binding MaxText}" FontSize="13"
                               HorizontalAlignment="Right" Style="{StaticResource Secondary}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="#0AFFFFFF" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="30,4,30,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,2">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" VerticalAlignment="Center"
                       Style="{StaticResource Secondary}" />
            <ui:TextBox Width="340" HorizontalAlignment="Left" PlaceholderText="Search sensors, devices or drive letters"
                        AutomationProperties.Name="Search sensors"
                        Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
            </ui:TextBox>
        </DockPanel>

        <!-- Virtualized: only rows in view get UI elements, so this opens instantly with hundreds of sensors. -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" Padding="0,0,6,24" Focusable="False">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- Skeleton while the first readings come in. -->
        <StackPanel Grid.Row="1" Margin="0,14,6,0"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <controls:Shimmer Height="56" CornerRadius="12" Margin="0,0,0,10" />
            <controls:Shimmer Height="18" CornerRadius="5" Margin="62,0,14,10" />
            <controls:Shimmer Height="18" CornerRadius="5" Margin="62,0,14,10" />
            <controls:Shimmer Height="18" CornerRadius="5" Margin="62,0,14,10" />
            <controls:Shimmer Height="18" CornerRadius="5" Margin="62,0,14,24" />
            <controls:Shimmer Height="56" CornerRadius="12" Margin="0,0,0,10" />
            <controls:Shimmer Height="18" CornerRadius="5" Margin="62,0,14,10" />
            <controls:Shimmer Height="18" CornerRadius="5" Margin="62,0,14,10" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="No sensors match your search." Margin="0,24,0,0"
                   HorizontalAlignment="Center" Style="{StaticResource Secondary}"
                   Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
