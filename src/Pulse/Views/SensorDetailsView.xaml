<UserControl x:Class="Pulse.Views.SensorDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Pulse.ViewModels"
             xmlns:controls="clr-namespace:Pulse.Controls"
             xmlns:views="clr-namespace:Pulse.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SensorDetailsViewModel}">

    <UserControl.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Pulse.PopupBackground}" BorderBrush="{DynamicResource Pulse.CardBorder}"
            BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,24,24">
            <StackPanel>

                <!-- Header: name (renameable), where it comes from, close -->
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Appearance="Transparent" Padding="6" VerticalAlignment="Top"
                               Command="{Binding CloseCommand}" ToolTip="Close (Esc)" AutomationProperties.Name="Close details">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="18" />
                    </ui:Button>
                    <StackPanel Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsEditingName, Converter={x:Static views:Converters.InverseBoolToVisibility}}">
                            <TextBlock Text="{Binding Name}" FontSize="20" Style="{StaticResource Metric}" TextWrapping="Wrap" />
                            <ui:Button Appearance="Transparent" Padding="6,4" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Command="{Binding BeginRenameCommand}" ToolTip="Rename" AutomationProperties.Name="Rename sensor">
                                <ui:SymbolIcon Symbol="Pen16" FontSize="14" />
                            </ui:Button>
                        </StackPanel>
                        <TextBox x:Name="NameBox" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" FontSize="16"
                                 Visibility="{Binding IsEditingName, Converter={StaticResource BoolToVisibility}}"
                                 IsVisibleChanged="NameBox_IsVisibleChanged" LostKeyboardFocus="NameBox_LostKeyboardFocus"
                                 AutomationProperties.Name="Sensor name">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding CommitRenameCommand}" />
                                <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
                        <ui:Button Content="Reset name" Appearance="Transparent" Padding="0,2" FontSize="12" HorizontalAlignment="Left"
                                   Command="{Binding ResetNameCommand}"
                                   Visibility="{Binding IsRenamed, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </DockPanel>

                <!-- Live value -->
                <StackPanel Orientation="Horizontal" Margin="0,14,0,16">
                    <TextBlock Text="{Binding ValueText}" FontSize="38" Style="{StaticResource Metric}" />
                    <TextBlock Text="now" Style="{StaticResource Secondary}" VerticalAlignment="Bottom" Margin="8,0,0,8" />
                </StackPanel>

                <!-- Range -->
                <Border Background="{DynamicResource Pulse.QuietFill}" CornerRadius="18" Padding="3" HorizontalAlignment="Left"
                        Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource NavPill}" GroupName="DetailsRange" Content="5 min"
                                     IsChecked="{Binding SelectedRangeIndex, Converter={x:Static views:Converters.IndexIs}, ConverterParameter=0}" />
                        <RadioButton Style="{StaticResource NavPill}" GroupName="DetailsRange" Content="1 hour"
                                     IsChecked="{Binding SelectedRangeIndex, Converter={x:Static views:Converters.IndexIs}, ConverterParameter=1}" />
                        <RadioButton Style="{StaticResource NavPill}" GroupName="DetailsRange" Content="24 hours"
                                     IsChecked="{Binding SelectedRangeIndex, Converter={x:Static views:Converters.IndexIs}, ConverterParameter=2}" />
                        <RadioButton Style="{StaticResource NavPill}" GroupName="DetailsRange" Content="7 days"
                                     IsChecked="{Binding SelectedRangeIndex, Converter={x:Static views:Converters.IndexIs}, ConverterParameter=3}" />
                    </StackPanel>
                </Border>

                <!-- Chart -->
                <controls:HistoryChart Height="270" Points="{Binding Points}" ComparePoints="{Binding ComparePoints}"
                                       From="{Binding From}" To="{Binding To}" Color="{Binding Accent}"
                                       CompareColor="{DynamicResource Pulse.Accent.Memory.Color}"
                                       ValueFormatter="{Binding ValueFormatter}"
                                       GridBrush="{DynamicResource Pulse.Divider}"
                                       LabelBrush="{DynamicResource Pulse.Text.Caption}"
                                       TooltipBackground="{DynamicResource Pulse.TooltipBackground}" />

                <!-- Range stats -->
                <UniformGrid Columns="3" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Lowest" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding MinText}" FontSize="18" Style="{StaticResource Metric}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Average" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding AvgText}" FontSize="18" Style="{StaticResource Metric}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Highest" Style="{StaticResource StatLabel}" />
                        <TextBlock Text="{Binding MaxText}" FontSize="18" Style="{StaticResource Metric}" />
                    </StackPanel>
                </UniformGrid>
                <TextBlock Text="{Binding AboveText}" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,10,0,0"
                           Visibility="{Binding AboveText, Converter={x:Static views:Converters.NotNullToVisibility}}" />

                <!-- Compare -->
                <DockPanel Margin="0,20,0,0">
                    <ComboBox DockPanel.Dock="Right" MinWidth="220" MaxWidth="260" ItemsSource="{Binding CompareChoices}"
                              SelectedItem="{Binding SelectedCompare}" DisplayMemberPath="Label"
                              AutomationProperties.Name="Compare with" />
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Compare with" Style="{StaticResource CardTitle}" FontSize="13" />
                        <TextBlock Text="Another sensor of the same kind, drawn in purple." Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>

                <!-- Actions -->
                <WrapPanel Margin="0,20,0,0">
                    <ui:Button x:Name="PinButton" Margin="0,0,8,8" Click="PinButton_Click"
                               Visibility="{Binding CanPin, Converter={StaticResource BoolToVisibility}}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon x:Name="PinIcon" Symbol="Pin20" />
                        </ui:Button.Icon>
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Content" Value="Pin to dashboard" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                        <Setter Property="Content" Value="Unpin" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:Button.ContextMenu>
                            <ContextMenu ItemsSource="{Binding PinChoices}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Setter Property="Header" Value="{Binding Label}" />
                                        <Setter Property="Command" Value="{Binding DataContext.PinToCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>
                    <ui:Button Content="Create alert" Margin="0,0,8,8" Command="{Binding CreateAlertCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Alert20" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Content="Export CSV…" Margin="0,0,8,8" Command="{Binding ExportCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="ArrowDownload20" />
                        </ui:Button.Icon>
                    </ui:Button>
                </WrapPanel>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextWrapping="Wrap"
                           Visibility="{Binding Status, Converter={x:Static views:Converters.NotNullToVisibility}}" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
