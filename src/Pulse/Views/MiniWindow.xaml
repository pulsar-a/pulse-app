<Window x:Class="Pulse.Views.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Pulse.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MiniViewModel}"
        Title="Pulse mini window"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" SizeToContent="WidthAndHeight"
        Left="-10000" Top="-10000"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!--
        Kept deliberately plain for games: no animations, no effects, text that changes once a second.
        Drag it anywhere; right-click for options.
    -->
    <Window.Resources>
        <!-- Stacked: a dot, the label, and the value on the right. -->
        <DataTemplate x:Key="Row" DataType="{x:Type vm:MiniItemViewModel}">
            <DockPanel Margin="0,3" MinWidth="150">
                <Ellipse Width="7" Height="7" Fill="{Binding AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" FontSize="17" Style="{StaticResource Metric}"
                           VerticalAlignment="Center" Margin="16,0,0,0" />
                <TextBlock Text="{Binding Label}" Style="{StaticResource Secondary}" FontSize="12" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>

        <!-- Side by side: the label over the value. -->
        <DataTemplate x:Key="Column" DataType="{x:Type vm:MiniItemViewModel}">
            <StackPanel Margin="0,0,18,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{Binding AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Secondary}" FontSize="11" />
                </StackPanel>
                <TextBlock Text="{Binding ValueText}" FontSize="18" Style="{StaticResource Metric}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Frame" Background="{DynamicResource Pulse.PopupBackground}" BorderBrush="{DynamicResource Pulse.CardBorder}"
            BorderThickness="1" CornerRadius="12" Padding="14,8,14,8" Opacity="{Binding WindowOpacity}">
        <Border.ContextMenu>
            <ContextMenu x:Name="Menu" Opened="Menu_Opened">
                <MenuItem x:Name="HorizontalItem" Header="Side by side" IsCheckable="True" Click="Horizontal_Click" />
                <MenuItem Header="Opacity">
                    <MenuItem Header="100%" Tag="1" Click="Opacity_Click" />
                    <MenuItem Header="90%" Tag="0.9" Click="Opacity_Click" />
                    <MenuItem Header="75%" Tag="0.75" Click="Opacity_Click" />
                    <MenuItem Header="60%" Tag="0.6" Click="Opacity_Click" />
                    <MenuItem Header="40%" Tag="0.4" Click="Opacity_Click" />
                </MenuItem>
                <MenuItem Header="Let clicks through" ToolTip="Clicks reach the window underneath. Turn it off from the tray icon or Settings."
                          Click="ClickThrough_Click" />
                <Separator />
                <MenuItem Header="Mini window settings…" Click="Settings_Click" />
                <MenuItem Header="Close" Click="Close_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.Style>
                <Style TargetType="ItemsControl">
                    <Setter Property="ItemTemplate" Value="{StaticResource Row}" />
                    <Setter Property="ItemsPanel">
                        <Setter.Value>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHorizontal}" Value="True">
                            <Setter Property="ItemTemplate" Value="{StaticResource Column}" />
                            <Setter Property="ItemsPanel">
                                <Setter.Value>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ItemsControl.Style>
        </ItemsControl>
    </Border>
</Window>
