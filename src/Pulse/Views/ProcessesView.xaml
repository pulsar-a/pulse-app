<UserControl x:Class="Pulse.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Pulse.ViewModels"
             xmlns:controls="clr-namespace:Pulse.Controls"
             xmlns:views="clr-namespace:Pulse.Views"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:ProcessesViewModel}">

    <UserControl.Resources>
        <!-- Shared by the header and the rows, so the columns line up. -->
        <system:Double x:Key="NumberColumn">92</system:Double>
        <system:Double x:Key="ActionColumn">108</system:Double>

        <!-- A column header that sorts when clicked. -->
        <Style x:Key="SortHeader" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Pulse.Text.Caption}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type vm:ProcessRowViewModel}">
            <Border x:Name="Row" Padding="10,7" CornerRadius="8" Background="Transparent" Margin="0,1">
                <DockPanel>
                    <!-- End task: shown on hover (or keyboard focus), only for the user's own programs. -->
                    <Grid DockPanel.Dock="Right" Width="{StaticResource ActionColumn}">
                        <ui:Button x:Name="End" Content="End task" Appearance="Transparent" Padding="10,3" FontSize="12"
                                   HorizontalAlignment="Right" Visibility="Hidden"
                                   Command="{Binding DataContext.EndTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   CommandParameter="{Binding}" AutomationProperties.Name="End task"
                                   ToolTip="Close this program and all its processes" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Right" Width="{StaticResource NumberColumn}" Text="{Binding MemoryText}" FontSize="13"
                               TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Metric}" FontWeight="Normal" />
                    <TextBlock DockPanel.Dock="Right" Width="{StaticResource NumberColumn}" Text="{Binding GpuText}" FontSize="13"
                               TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Metric}" FontWeight="Normal"
                               Visibility="{Binding DataContext.HasGpu, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel DockPanel.Dock="Right" Width="{StaticResource NumberColumn}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CpuText}" FontSize="13" TextAlignment="Right" Style="{StaticResource Metric}" FontWeight="Normal" />
                        <Grid Width="56" HorizontalAlignment="Right" Margin="0,3,0,0">
                            <Border Style="{StaticResource BarTrack}" Height="3" />
                            <Border Style="{StaticResource BarTrack}" Height="3" Background="{DynamicResource Pulse.Accent.Cpu}" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding CpuFraction}" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <Grid DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Apps20" FontSize="16" Foreground="{DynamicResource Pulse.Text.Caption}"
                                       Visibility="{Binding Icon, Converter={x:Static views:Converters.NullToVisibility}}" />
                        <Image Source="{Binding Icon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Name}" FontSize="13" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" ToolTip="{Binding Name}" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource Pulse.RowHover}" />
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, ElementName=Row}" Value="True" />
                        <Condition Binding="{Binding CanEnd}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="End" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=Row}" Value="True" />
                        <Condition Binding="{Binding CanEnd}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="End" Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="30,4,30,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,2">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" VerticalAlignment="Center"
                       Style="{StaticResource Secondary}" />
            <ui:TextBox MaxWidth="340" HorizontalAlignment="Stretch" Margin="0,0,12,0" PlaceholderText="Search programs"
                        AutomationProperties.Name="Search programs"
                        Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
            </ui:TextBox>
        </DockPanel>

        <TextBlock Grid.Row="1" Text="{Binding Message}" Style="{StaticResource Secondary}" Margin="2,10,0,0" TextWrapping="Wrap"
                   Visibility="{Binding Message, Converter={x:Static views:Converters.NotNullToVisibility}}" />

        <!-- Column headers: click to sort, click again to flip. -->
        <DockPanel Grid.Row="2" Margin="10,14,16,4">
            <Border DockPanel.Dock="Right" Width="{StaticResource ActionColumn}" />
            <Button DockPanel.Dock="Right" Width="{StaticResource NumberColumn}" Style="{StaticResource SortHeader}" HorizontalContentAlignment="Right"
                    Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProcessSort.Memory}"
                    AutomationProperties.Name="Sort by memory">
                <TextBlock><Run Text="Memory" /><Run Text="{Binding MemoryArrow, Mode=OneWay}" /></TextBlock>
            </Button>
            <Button DockPanel.Dock="Right" Width="{StaticResource NumberColumn}" Style="{StaticResource SortHeader}" HorizontalContentAlignment="Right"
                    Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProcessSort.Gpu}"
                    AutomationProperties.Name="Sort by GPU"
                    Visibility="{Binding HasGpu, Converter={StaticResource BoolToVisibility}}">
                <TextBlock><Run Text="GPU" /><Run Text="{Binding GpuArrow, Mode=OneWay}" /></TextBlock>
            </Button>
            <Button DockPanel.Dock="Right" Width="{StaticResource NumberColumn}" Style="{StaticResource SortHeader}" HorizontalContentAlignment="Right"
                    Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProcessSort.Cpu}"
                    AutomationProperties.Name="Sort by CPU">
                <TextBlock><Run Text="CPU" /><Run Text="{Binding CpuArrow, Mode=OneWay}" /></TextBlock>
            </Button>
            <Button Style="{StaticResource SortHeader}" HorizontalContentAlignment="Left" Margin="32,0,0,0"
                    Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ProcessSort.Name}"
                    AutomationProperties.Name="Sort by name">
                <TextBlock><Run Text="Program" /><Run Text="{Binding NameArrow, Mode=OneWay}" /></TextBlock>
            </Button>
        </DockPanel>

        <!-- Virtualized: only rows in view get UI elements. -->
        <ItemsControl Grid.Row="3" ItemsSource="{Binding Rows}" Focusable="False"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" Padding="0,0,6,24" Focusable="False">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- Skeleton until the second reading gives the first figures. -->
        <StackPanel Grid.Row="3" Margin="0,6,6,0"
                    Visibility="{Binding HasData, Converter={x:Static views:Converters.InverseBoolToVisibility}}">
            <controls:Shimmer Height="38" CornerRadius="8" Margin="0,0,0,8" />
            <controls:Shimmer Height="38" CornerRadius="8" Margin="0,0,0,8" />
            <controls:Shimmer Height="38" CornerRadius="8" Margin="0,0,0,8" />
            <controls:Shimmer Height="38" CornerRadius="8" Margin="0,0,0,8" />
            <controls:Shimmer Height="38" CornerRadius="8" Margin="0,0,0,8" />
        </StackPanel>

        <TextBlock Grid.Row="3" Text="No programs match your search." Margin="0,24,0,0"
                   HorizontalAlignment="Center" Style="{StaticResource Secondary}"
                   Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
