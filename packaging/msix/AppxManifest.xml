<?xml version="1.0" encoding="utf-8"?>
<!--
  The Microsoft Store package (make msix). The same Pulse as the GitHub installer, self-contained, in an MSIX package
  that the Store signs. Placeholders in $…$ are filled by tools/msix.ps1: the identity values come from Partner
  Center (Product identity, after reserving the app's name).

  Two restricted capabilities, both needing a reason in the Store submission:
  - runFullTrust: Pulse is a normal desktop app (WPF), not a sandboxed one.
  - allowElevation: Pulse asks for administrator rights itself (Elevation.cs); Windows only lets an administrator
    program read CPU, motherboard and drive sensors.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity Name="$IdentityName$" Publisher="$Publisher$" Version="$Version$" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>$DisplayName$</DisplayName>
    <PublisherDisplayName>$PublisherDisplayName$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>A good-looking hardware monitor: temperatures, fans, pump, power, drives and network, with history and alerts.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Pulse" Executable="Pulse.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="$DisplayName$"
        Description="Hardware monitor: temperatures, fans, pump, power, drives and network."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- pulse.exe in the user's WindowsApps folder: how the startup task and an elevated relaunch start Pulse
             with its package identity (see AppPackage.cs). -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="Pulse.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="pulse.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="allowElevation" />
  </Capabilities>
</Package>
